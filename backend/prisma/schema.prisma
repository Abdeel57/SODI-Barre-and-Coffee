generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  name                String
  email               String         @unique
  phone               String?
  /// Teléfono en 10 dígitos, sin lada ni formato — permite iniciar sesión con el número
  phoneNormalized     String?
  passwordHash        String
  role                Role           @default(STUDENT)
  pushToken           String?
  gender              Gender?
  birthDate           DateTime?
  onboardingCompleted Boolean        @default(false)
  totalClassesTaken   Int            @default(0)
  /// Clases de cortesía disponibles (promo de inauguración, regalos del staff)
  bonusClasses        Int            @default(0)
  avatar              String?
  createdAt           DateTime       @default(now())
  bookings            Booking[]
  subscription        Subscription?
  payments            Payment[]
  healthProfile       HealthProfile?
  coachClasses        Class[]        @relation("CoachClasses")
  rewards             Reward[]
  recurringBookings   RecurringBooking[]

  @@index([phoneNormalized])
}

model Reward {
  id         String     @id @default(cuid())
  userId     String
  type       RewardType
  code       String     @unique @default(cuid())
  isRedeemed Boolean    @default(false)
  redeemedAt DateTime?
  createdAt  DateTime   @default(now())
  /// Origen: MILESTONE | PROMO_INAUGURACION | ADMIN_GIFT
  source     String     @default("MILESTONE")
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, source])
}

model HealthProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  hasSurgeries          Boolean  @default(false)
  surgeriesDetail       String?
  isPregnant            Boolean  @default(false)
  pregnancyWeeks        Int?
  bloodType             String?
  emergencyContactName  String?
  emergencyContactPhone String?
  allergies             String?
  injuries              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Class {
  id          String    @id @default(cuid())
  name        String
  instructor  String
  dayOfWeek   Int       // 0=Dom 1=Lun ... 6=Sáb
  startTime   String    // "09:00"
  startDate   DateTime? // 1ª fecha en que se imparte (null = siempre)
  endDate     DateTime? // última fecha inclusive (null = sin fin)
  durationMin Int       @default(55)
  maxCapacity Int       @default(12)
  isActive    Boolean   @default(true)
  coachId     String?
  bookings    Booking[]
  coach       User?     @relation("CoachClasses", fields: [coachId], references: [id], onDelete: SetNull)
  recurring   RecurringBooking[]
}

model Booking {
  id          String            @id @default(cuid())
  userId      String
  classId     String
  date        DateTime
  status      BookingStatus     @default(CONFIRMED)
  createdAt   DateTime          @default(now())
  /// true = se pagó con una clase de cortesía, no con el paquete
  usedBonus   Boolean           @default(false)
  /// Regla de horario fijo que generó esta reserva (null = reserva manual)
  recurringId String?
  user        User              @relation(fields: [userId], references: [id])
  class       Class             @relation(fields: [classId], references: [id])
  recurring   RecurringBooking? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@unique([userId, classId, date])
  @@index([recurringId])
}

/// Horario fijo: "quiero esta clase todos los miércoles".
/// No reserva sola — aparta el lugar y un cron va creando los Booking
/// de las próximas semanas (ver services/recurring.ts).
model RecurringBooking {
  id              String    @id @default(cuid())
  userId          String
  classId         String
  isActive        Boolean   @default(true)
  /// Primera fecha en la que aplica (medianoche local, igual que Booking.date)
  startDate       DateTime
  /// Última fecha inclusive — null = indefinido
  endDate         DateTime?
  /// Fecha de la ocurrencia del último aviso de fallo, para no repetir el push
  lastNotifiedFor DateTime?
  createdAt       DateTime  @default(now())
  cancelledAt     DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  class           Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@unique([userId, classId])
  @@index([classId, isActive])
}

model Package {
  id            String         @id @default(cuid())
  name          String
  description   String?
  classCount    Int?           // null = ilimitado
  validDays     Int
  priceMXN      Float
  isActive      Boolean        @default(true)
  subscriptions Subscription[]
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String   @unique
  packageId   String
  classesLeft Int?     // null = ilimitado
  expiresAt   DateTime
  isActive    Boolean  @default(true)
  user        User     @relation(fields: [userId], references: [id])
  package     Package  @relation(fields: [packageId], references: [id])
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  packageId     String
  amountMXN     Float
  mpPaymentId   String        @unique
  /// ID de la preferencia (el checkout). Es lo que amarra el registro pendiente
  /// con el pago real de MercadoPago: sin esto no se pueden reconciliar.
  preferenceId  String?       @unique
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  /// Cuándo se resolvió (aprobado o rechazado)
  resolvedAt    DateTime?
  /// Última vez que se le preguntó a MercadoPago por este pago
  lastCheckedAt DateTime?
  user          User          @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
}

enum Role {
  STUDENT
  ADMIN
  COACH
}

enum Gender {
  FEMALE
  MALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  ATTENDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RewardType {
  CAFE_FREE
  FREE_CLASS
}
